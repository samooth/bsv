  "repository": {
    "type": "git",
    "url": "git+https://github.com/samooth/bsv.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "aes": "^0.1.0",
    "bitcoin-elliptic": "^7.0.1",
    "bn.js": "^5.2.2",
    "bs58": "6.0.0",
    "buffer": "^6.0.3",
    "hash.js": "^1.1.7",
    "is-hexadecimal": "^2.0.1",
    "pbkdf2": "^3.1.7",
    "randombytes": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "assert": "2.1.0",
    "crypto-browserify": "^3.12.1",
    "eslint": "^9.39.2",
    "esm": "^3.2.25",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
